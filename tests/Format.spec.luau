--!strict
local Format = require("../src/ReplicatedStorage/Shared/Format")
local TestKit = require("./TestKit")

return function(t: TestKit.T)
	t.test("small numbers are whole", function()
		t.eq(Format.number(0), "0")
		t.eq(Format.number(7.9), "7")
		t.eq(Format.number(999), "999")
	end)

	t.test("thousands to trillions", function()
		t.eq(Format.number(1000), "1K")
		t.eq(Format.number(1234), "1.23K")
		t.eq(Format.number(12_345), "12.3K")
		t.eq(Format.number(123_456), "123K")
		t.eq(Format.number(1_500_000), "1.5M")
		t.eq(Format.number(2e9), "2B")
		t.eq(Format.number(3.45e12), "3.45T")
	end)

	t.test("never rounds up past the real value", function()
		t.eq(Format.number(999_999), "999K")
		t.eq(Format.number(1_999), "1.99K")
	end)

	t.test("letter suffixes after T", function()
		t.eq(Format.number(1e15), "1aa")
		t.eq(Format.number(1e18), "1ab")
		t.eq(Format.number(2.5e16), "25aa")
	end)

	t.test("edge values", function()
		t.eq(Format.number(-1234), "-1.23K")
		t.eq(Format.number(0 / 0), "0")
		t.eq(Format.number(math.huge), "∞")
	end)

	t.test("commas", function()
		t.eq(Format.commas(1234567), "1,234,567")
		t.eq(Format.commas(999), "999")
		t.eq(Format.commas(-1000), "-1,000")
	end)

	t.test("duration and clock", function()
		t.eq(Format.duration(45), "45s")
		t.eq(Format.duration(125), "2m 5s")
		t.eq(Format.duration(3725), "1h 2m")
		t.eq(Format.duration(90000), "1d 1h")
		t.eq(Format.clock(125), "2:05")
		t.eq(Format.clock(3725), "1:02:05")
	end)

	t.test("rate keeps one decimal for small values", function()
		t.eq(Format.rate(1), "1")
		t.eq(Format.rate(1.5), "1.5")
		t.eq(Format.rate(2.25), "2.3")
		t.eq(Format.rate(99.94), "99.9")
		t.eq(Format.rate(150), "150")
		t.eq(Format.rate(2500), "2.5K")
	end)
end
